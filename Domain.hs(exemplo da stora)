--exemplo de relação entre duas entidades

--função que recebe uma chamada e pesqueisa 
--na lista telefónica o nome da pessoa que ligou 

quemligou :: Chamda->LTelefonica->String
quemligou _ [] = "Numero Desconhecido"
quemligou ch (x:xs)
        |telefone x == telefoneOrigem ch = nome x
        |otherwise =quemligou ch xs




